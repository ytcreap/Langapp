<resources>
    <!--  Light theme  -->
    <style name="Theme.LangApp.Light" parent="Theme.MaterialComponents.Light">
        <item name="colorPrimary">@color/purple_40</item>
        <item name="colorSecondary">@color/purple_grey_40</item>
        <item name="colorTertiary">@color/pink_40</item>
        <item name="colorSurfaceVariant">@color/light_surface</item>
    </style>
    <style name="LevelCardStyle" parent="Widget.MaterialComponents.CardView">
        <item name="cardElevation">6dp</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="android:layout_margin">8dp</item>
    </style>
    <style name="LevelTitleText" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <style name="CustomTaskDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="buttonBarPositiveButtonStyle">@style/CustomDialogButton</item>
    </style>
    <style name="CustomDialogButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">#667EEA</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="CustomTaskDialogSimple" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="materialAlertDialogTitleTextStyle">@style/CustomDialogTitle</item>
        <item name="materialAlertDialogBodyTextStyle">@style/CustomDialogBody</item>
        <item name="buttonBarPositiveButtonStyle">@style/CustomDialogButton</item>
    </style>
    <style name="CustomDialogTitle" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textColor">#667EEA</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="CustomDialogBody" parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="android:textColor">#333333</item>
        <item name="android:textSize">16sp</item>
    </style>
</resources>
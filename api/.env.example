PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# json | mongo
DATA_SOURCE=json

# JSON mode
JSON_DB_PATH=./languageguidev2-default-rtdb-export (1).json
JSON_WRITE_DEBOUNCE_MS=150

# Mongo mode. Install optional dependency first: npm install
# MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=langapp
MONGODB_COLLECTION=database

# Comma-separated origins or *.
CORS_ORIGIN=*
